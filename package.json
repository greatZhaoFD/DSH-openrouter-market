{
  "name": "dsh-openrouter-market",
  "version": "0.2.1",
  "description": "Browse the live OpenRouter catalogue in DSH Settings models and merge selected models into the DSH OpenRouter model configuration.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openrouter",
    "models",
    "catalog",
    "router",
    "web-ui"
  ],
  "author": "greatZhaoFD",
  "license": "MIT",
  "homepage": "https://github.com/greatZhaoFD/DSH-openrouter-market#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greatZhaoFD/DSH-openrouter-market.git"
  },
  "bugs": {
    "url": "https://github.com/greatZhaoFD/DSH-openrouter-market/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icons/*",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
